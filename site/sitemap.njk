---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- if site.url %}
{%- for pagina in collections.all %}
    <url>
        <loc>{{ site.url }}{{ pagina.url }}</loc>
    </url>
{%- endfor %}
{%- endif %}
</urlset>
