---
layout: layouts/base.njk
title: Notas Técnicas
description: Acervo completo e pesquisável das Notas Técnicas do CIn — busca no conteúdo integral, não só no título.
permalink: /notas-tecnicas/
---
{% simboloIcone "solid/file-pdf", "icone-file-pdf" %}
{% simboloIcone "solid/arrow-up-right-from-square", "icone-externo" %}
{% simboloIcone "solid/magnifying-glass", "icone-busca" %}
{% simboloIcone "solid/xmark", "icone-limpar" %}

    <!-- Cabeçalho da página -->
    <section class="page-header">
        <div class="container">
            <h1 class="section-title">Notas Técnicas</h1>
            <p class="section-subtitle">Todas as {{ notasTecnicas.length }} Notas Técnicas do CIn desde {{ notasTecnicas[notasTecnicas.length - 1].ano }}, num só lugar. Pesquise por título, número, autor ou pelo conteúdo completo de cada documento.</p>
        </div>
    </section>

    <!-- Busca em texto integral (Pagefind) -->
    <section class="acervo-section">
        <div class="container">
            <div class="busca-nts-linha">
                <div class="busca-nts-wrap" id="buscaNtsWrap">
                    <label for="buscaNts" class="sr-only">Buscar no conteúdo das Notas Técnicas</label>
                    <span class="busca-nts-icone">{% usarIcone "icone-busca" %}</span>
                    <input type="search" id="buscaNts" class="busca-nts-input" placeholder="Buscar no conteúdo completo das Notas Técnicas…" autocomplete="off">
                    <button type="button" id="buscaNtsLimpar" class="busca-nts-limpar" hidden aria-label="Limpar busca">{% usarIcone "icone-limpar" %}</button>
                </div>
                <div class="notas-filtro-ano-wrap">
                    <label for="anoSelect" class="sr-only">Filtrar por ano</label>
                    <select id="anoSelect" class="notas-filtro-ano">
                        <option value="">Todos os anos</option>
                        {%- for ano in notasTecnicas | anosUnicos %}
                        <option value="{{ ano }}">{{ ano }}</option>
                        {%- endfor %}
                    </select>
                </div>
            </div>
            <p class="acervo-contagem" id="buscaContagem" aria-live="polite"></p>

            <!-- Resultados da busca (ocultos até haver uma consulta) -->
            <div class="acervo-grid" id="resultadosBusca" hidden></div>

            <!-- Listagem completa (padrão, some quando há busca ativa) -->
            <div class="acervo-grid" id="listaCompletaNts">
                {%- for nt in notasTecnicas %}
                <article class="documento-card" data-ano="{{ nt.ano }}">
                    <a href="/notas-tecnicas/{{ nt.id }}/" style="text-decoration:none; color:inherit;">
                        <div class="documento-corpo">
                            <span class="documento-capa documento-capa-fallback">{% usarIcone "icone-file-pdf" %}</span>
                            <div class="documento-info">
                                <span class="serie-tag">Nota Técnica</span>
                                <h3 class="documento-titulo">{{ nt.titulo }}</h3>
                                {%- if nt.autor %}
                                <p class="documento-autor">{{ nt.autor | truncate(60) }}</p>
                                {%- endif %}
                                <p class="documento-descricao">{{ nt.descricao | truncate(140) }}</p>
                            </div>
                        </div>
                        <div class="documento-footer">
                            <span class="documento-meta"><time datetime="{{ nt.ano }}">{{ nt.ano }}</time> · PDF</span>
                        </div>
                    </a>
                </article>
                {%- endfor %}
            </div>
        </div>
    </section>

    <script src="/busca-nts.js"></script>
